{
    float3 aPosition [[attribute(0)]];
    float3 aNormal [[attribute(1)]];
};

vertex main0_out main0(main0_in in [[stage_in]], constant DrawUniforms& _19 [[buffer(0)]])
{
    main0_out out = {};
